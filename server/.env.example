# Clé API Groq (https://console.groq.com/keys). Laisser vide pour le mode démo (réponses mockées).
GROQ_API_KEY=
# Modèle Groq utilisé
GROQ_MODEL=llama-3.3-70b-versatile
# Port du serveur
PORT=3001
# Origines autorisées, séparées par des virgules (client React, app Flutter web en dev)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174
